<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The panel has no hardware Back/Home/Recents keys. -->
    <bool name="config_showNavigationBar">true</bool>

    <!-- Use Android 10's full gesture navigation as the factory default. -->
    <integer name="config_navBarInteractionMode">2</integer>

    <!-- MTK Wi-Fi tethering uses p2p0; retain the generic ap* path too. -->
    <string-array translatable="false" name="config_tether_wifi_regexs">
        <item>p2p\\d</item>
        <item>ap\\d</item>
    </string-array>
</resources>

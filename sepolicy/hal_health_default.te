# MTK6580 exposes battery nodes under sysfs_power_supply.
# Android 10 BatteryService reaches them through the vendor health HAL.
allow hal_health_default sysfs_power_supply:dir r_dir_perms;
allow hal_health_default sysfs_power_supply:file r_file_perms;
allow hal_health_default sysfs_power_supply:lnk_file r_file_perms;
